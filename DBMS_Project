    try{
        $pdo->beginTransaction();
        $sid = $_POST['Student_ID'];
        $cid = $_POST['Course_ID'];
        $sem = $_POST['Semester_ID'];
        $quiz = $_POST['Quiz_Marks'];
        $assign = $_POST['Assignment_Marks'];
        $mid = $_POST['Mid_Marks'];
        $final = $_POST['Final_Marks'];

        $enr = $pdo->prepare("SELECT COUNT(*) FROM Enrollment WHERE Student_ID=? AND Course_ID=? AND Semester_ID=?");
        $enr->execute([$sid,$cid,$sem]);
        if($enr->fetchColumn() == 0){ throw new Exception("Student not enrolled in this course/semester"); }
        $enr = null; // closeCursor ki jagah null kar diya

        $check = $pdo->prepare("SELECT COUNT(*) FROM Grades WHERE Student_ID=? AND Course_ID=? AND Semester_ID=?");
        $check->execute([$sid,$cid,$sem]);
        $exists = $check->fetchColumn();
        $check = null;

        if($exists > 0){
            $stmt = $pdo->prepare("UPDATE Grades SET Quiz_Marks=?,Assignment_Marks=?,Mid_Marks=?,Final_Marks=? WHERE Student_ID=? AND Course_ID=? AND Semester_ID=?");
            $stmt->execute([$quiz,$assign,$mid,$final,$sid,$cid,$sem]);
            $stmt = null;
            $success = "Grades Updated!";
        } else {
            $stmt = $pdo->prepare("INSERT INTO Grades (Student_ID,Course_ID,Semester_ID,Quiz_Marks,Assignment_Marks,Mid_Marks,Final_Marks) VALUES (?,?,?,?,?,?,?)");
            $stmt->execute([$sid,$cid,$sem,$quiz,$assign,$mid,$final]);
            $stmt = null;
            $success = "Grades Added!";
        }

        // PROCEDURE ko SAFE tareeqe se chalao - YE CHANGE KIYA HAI
       // $pdo->exec("CALL CalculateGPA($sid,$cid,$sem)");
       // $pdo->query("SELECT 1"); // Force buffer clear

        $stmt = $pdo->prepare("INSERT INTO Notifications (Type,Notification_Date,Message,Admin_ID,Student_ID,Faculty_ID) VALUES ('Student',CURDATE(),'Your grades have been updated.',1,?,?)");
        $stmt->execute([$sid,$faculty_id]);
        $stmt = null;
        
        $pdo->commit();
        header("Location: grades.php?success=$success"); exit();

    }catch(Exception $e){
        $pdo->rollBack();
        $error = $e->getMessage();
    }
}

// 2. DELETE
if(isset($_GET['delete'])){
