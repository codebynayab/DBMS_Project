if($sel_course && $sel_sem){
    $stmt = $pdo->prepare(
        "SELECT s.* FROM Student s
         JOIN Enrollment e ON s.Student_ID = e.Student_ID
         WHERE e.Course_ID=? AND e.Semester_ID=?
         ORDER BY s.Roll_No"
    );
    $stmt->execute([$sel_course, $sel_sem]);
