checkAdminLogin();

// 1. Save/Update grades
if($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['Student_ID'])){
    $sid   = intval($_POST['Student_ID']);
    $cid   = intval($_POST['Course_ID']);
    $semid = intval($_POST['Semester_ID']);
    $quiz  = intval($_POST['Quiz_Marks']);
    $asgn  = intval($_POST['Assignment_Marks']);
    $mid   = intval($_POST['Mid_Marks']);
    $final = intval($_POST['Final_Marks']);

    // Calculate
    $total = $quiz + $asgn + $mid + $final;
    $percentage = $total; // 100 me se hai

    if($total >= 90){ $grade = 'A+'; $gpa = 4.00; }
    elseif($total >= 85){ $grade = 'A';  $gpa = 3.70; }
    elseif($total >= 80){ $grade = 'B+'; $gpa = 3.30; }
    elseif($total >= 75){ $grade = 'B';  $gpa = 3.00; }
    elseif($total >= 70){ $grade = 'B-'; $gpa = 2.70; }
    elseif($total >= 65){ $grade = 'C+'; $gpa = 2.30; }
    elseif($total >= 60){ $grade = 'C';  $gpa = 2.00; }
    else{ $grade = 'F'; $gpa = 0.00; }

    // Check if exists then update else insert
    $check = $pdo->prepare("SELECT COUNT(*) as c FROM Grades WHERE Student_ID=? AND Course_ID=? AND Semester_ID=?");
    $check->execute([$sid, $cid, $semid]);
    
    if($check->fetch()['c'] > 0){
        $pdo->prepare("UPDATE Grades SET Quiz_Marks=?, Assignment_Marks=?, Mid_Marks=?, Final_Marks=?, Total_Marks=?, Percentage=?, Grade=?, GPA=? WHERE Student_ID=? AND Course_ID=? AND Semester_ID=?")
        ->execute([$quiz, $asgn, $mid, $final, $total, $percentage, $grade, $gpa, $sid, $cid, $semid]);
    } else {
        $pdo->prepare("INSERT INTO Grades (Student_ID, Course_ID, Semester_ID, Quiz_Marks, Assignment_Marks, Mid_Marks, Final_Marks, Total_Marks, Percentage, Grade, GPA) VALUES (?,?,?,?,?,?,?)")
        ->execute([$sid, $cid, $semid, $quiz, $asgn, $mid, $final, $total, $percentage, $grade, $gpa]);
    }
    
    header("Location: grades.php?success=1");
    exit();
}

// 2. Delete/Reset grades
if(isset($_GET['delete'])){
    $parts = explode('-', $_GET['delete']);
    $pdo->prepare("UPDATE Grades SET Quiz_Marks=0, Assignment_Marks=0, Mid_Marks=0, Final_Marks=0, Total_Marks=0, Grade='F', Percentage=0, GPA=0, CGPA=0 WHERE Student_ID=? AND Course_ID=? AND Semester_ID=?")
    ->execute($parts);
    header("Location: grades.php?success=deleted");
    exit();
}

