<script>
function submitAttendance(){
    let present = 0, absent = 0;
    let course = document.getElementById("courseFilter").value;
    let date   = document.getElementById("attendanceDate").value;
    if(date == ""){
        alert("Please select a date.");
        return;
    }
    let rows = document.querySelectorAll("#attendanceTable tr");
    for(let i=1; i<rows.length; i++){
        let radios = rows[i].querySelectorAll("input[type='radio']");
        rows[i].style.backgroundColor = "";
        radios.forEach(radio => {
            if(radio.checked){
                if(radio.value == "Present"){
                    present++;
                    rows[i].style.backgroundColor = "#d4edda";
                } else {
                    absent++;
                    rows[i].style.backgroundColor = "#f8d7da";
                }
            }
        });
    }
    document.getElementById("presentCount").innerHTML = present;
    document.getElementById("absentCount").innerHTML  = absent;
}
</script>
</body>
