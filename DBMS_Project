if($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['attendance'])){
    $course_id   = $_POST['Course_ID'];
    $semester_id = $_POST['Semester_ID'];
    $date        = $_POST['Attendance_Date'];

    $inserted = 0;
    foreach($_POST['attendance'] as $student_id => $status){
        // Check duplicate
        $check = $pdo->prepare(
            "SELECT COUNT(*) as c FROM Attendance
             WHERE Student_ID=? AND Course_ID=? AND Semester_ID=? AND Attendance_Date=?"
        );
        $check->execute([$student_id, $course_id, $semester_id, $date]);

        if($check->fetch()['c'] == 0){
            $pdo->prepare(
                "INSERT INTO Attendance
                 (Student_ID, Course_ID, Semester_ID, Attendance_Date, Attendance_Status, Faculty_ID)
                 VALUES (?,?,?,?,?,?)"
            )->execute([$student_id, $course_id, $semester_id, $date, $status, $faculty_id]);
            $inserted++;
        }
    }
    header("Location: attendance.php?success=1&inserted=$inserted");
    exit();
}

// Get faculty courses — ALL courses assigned to this faculty
$courses = $pdo->prepare("SELECT * FROM Course WHERE Faculty_ID=?");
$courses->execute([$faculty_id]);
$courses = $courses->fetchAll();

// Get ALL semesters
$semesters = $pdo->query("SELECT * FROM Semester ORDER BY Semester_ID")->fetchAll();

// Get students based on selected course+semester
