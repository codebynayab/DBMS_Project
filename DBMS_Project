    $cn = $pdo->prepare("SELECT Course_Name FROM Course WHERE Course_ID=?");
    $cn->execute([$sel_course]);
    $cn = $cn->fetch();
    $course_name = $cn ? $cn['Course_Name'] : '';
}

// Present/Absent count from today
$present_count = 0;
$absent_count  = 0;
if($sel_course && $sel_sem){
    $cnt = $pdo->prepare(
        "SELECT
            SUM(CASE WHEN Attendance_Status='Present' THEN 1 ELSE 0 END) as p,
            SUM(CASE WHEN Attendance_Status='Absent'  THEN 1 ELSE 0 END) as a
         FROM Attendance
         WHERE Course_ID=? AND Semester_ID=? AND Faculty_ID=? AND Attendance_Date=?"
    );
    $cnt->execute([$sel_course, $sel_sem, $faculty_id, date('Y-m-d')]);
